# ==============================================================================
# DraftSpace Root / Server Environment Configuration
# ==============================================================================

# Server Port
PORT=4000
NODE_ENV=development

# Database Connection URL
# For PostgreSQL (Production / Docker / Neon / Supabase):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/draftspace?schema=public"

# For SQLite (Zero-friction local dev & instant testing without local Postgres installed):
# Set DATABASE_URL="file:./dev.db" if running with SQLite provider.

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Client API Base URL (used by Vite client)
VITE_API_URL="http://localhost:4000/api"
